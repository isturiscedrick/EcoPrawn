{
  "name": "ecoprawn-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "bun --bun vite build",
    "start": "bun --env-file=.env --env-file=.env.local .output/server/index.mjs",
    "typecheck": "bun --bun tsc --noEmit",
    "test:navigation": "bun --no-env-file scripts/test-navigation.mjs",
    "test:mobile-layout": "bun --no-env-file scripts/test-mobile-layout.mjs",
    "test:auth-proxy": "bun --no-env-file scripts/test-auth-proxy.mjs",
    "test:tank-validation": "bun --no-env-file test ./scripts/test-tank-validation.mjs",
    "test:responses": "bun --no-env-file scripts/test-response-validation.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.261029-rc",
    "playwright": "1.64.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "vite": "8.3.5"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  }
}
