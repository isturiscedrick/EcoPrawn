# Merge into backend/.env. Use the same secret in the local Python process.
GROWTH_AI_URL=http://127.0.0.1:8010
GROWTH_AI_KEY=replace-with-random-secret-at-least-24-characters
# Use an absolute private directory outside public web roots and cloud-sync folders.
GROWTH_STORAGE_DIR=C:/EcoPrawn/private-growth-images
GROWTH_STORAGE_MAX_BYTES=1073741824
GROWTH_FORECAST_ENABLED=false
