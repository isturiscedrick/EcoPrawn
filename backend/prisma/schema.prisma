generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tank {
  id              String             @id @default(cuid())
  // Null is reserved for legacy records whose owner cannot be established.
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  pl              String             @default("PL-42")
  biomass         Float              @default(31.2) // in kg
  targetToday     Float              @default(1.5)  // kg
  fcr             Float              @default(1.35)
  dispensedToday  Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  telemetries     SensorTelemetry[]
  hardwareTelemetries HardwareTelemetry[]
  visionScans     VisionScan[]
  feedSchedules   FeedSchedule[]
  effluentLogs    EffluentLog[]
  alerts          Alert[]
  @@index([userId])
}

// Partial measurements from connected hardware. Absent sensors stay null.
model HardwareTelemetry {
  id          String   @id @default(cuid())
  tankId      String
  tank        Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
  temperature Float?
  distanceCm  Float?
  waterLevel  Float?
  recordedAt  DateTime @default(now())

  @@index([tankId, recordedAt])
}

model SensorTelemetry {
  id              String   @id @default(cuid())
  tankId          String
  tank            Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
  dissolvedOxygen Float    // mg/L
  ph              Float    // pH
  temperature     Float    // °C
  salinity        Float    // ppt
  waterLevel      Float    // %
  recordedAt      DateTime @default(now())

  @@index([tankId, recordedAt])
}

model VisionScan {
  id            String   @id @default(cuid())
  tankId        String
  tank          Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
  bodyLength    Float    // cm
  weight        Float    // g
  population    Int
  abnormalCount Int      @default(0)
  notes         String?
  recordedAt    DateTime @default(now())

  @@index([tankId, recordedAt])
}

model FeedSchedule {
  id        String   @id @default(cuid())
  tankId    String
  tank      Tank     @relation(fields: [tankId], references: [id], onDelete: Cascade)
  timeSlot  String   // e.g. "06:00", "10:00", "14:00", "18:00"
  amountKg  Float    // kg
  status    String   @default("upcoming") // "done" | "upcoming"
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([tankId])
}

model BioflocMetric {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  flocVolume Float    // mL/L (FV)
  cnRatio    Float    // C:N ratio
  tss        Float    // Total Suspended Solids (mg/L)
  alkalinity Float    // mg/L CaCO3
  recordedAt DateTime @default(now())
  @@index([userId, recordedAt])
}

model EffluentLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tankId      String?
  tank        Tank?    @relation(fields: [tankId], references: [id], onDelete: SetNull)
  event       String
  detail      String
  destination String?  // "mangrove" | "wetland"
  volumeL     Float?
  recordedAt  DateTime @default(now())
  @@index([userId, recordedAt])
  @@index([tankId])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tankId    String?
  tank      Tank?    @relation(fields: [tankId], references: [id], onDelete: SetNull)
  icon      String   @default("info") // "warn" | "info"
  title     String
  detail    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([tankId])
}

model User {
  id        String   @id @default(cuid())
  authId    String?  @unique @db.Uuid
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("operator") // "operator" | "admin"
  createdAt DateTime @default(now())
  tanks     Tank[]
  bioflocMetrics BioflocMetric[]
  effluentLogs EffluentLog[]
  alerts    Alert[]
  smsPhone  String?
  smsEnabled Boolean @default(false)
  lastSmsAt DateTime?
  smsDeliveries SmsDelivery[]
}

model SmsDelivery {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tankId      String?
  recipient   String
  content     String
  status      String @default("sending")
  referenceId String? @unique
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}
