# PostgreSQL connection string for EcoPrawn
# Replace YOUR_PASSWORD with the password you set during PostgreSQL 18 installation
DATABASE_URL="postgresql://postgres:jameel@localhost:5432/ecoprawn_db?schema=public"

# Browser-facing frontend origin. HTTPS is required outside localhost in production.
APP_URL="http://localhost:3000"
# Supabase Auth uses the project's publishable key, not the service-role key.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
# Configure Google client ID and secret in Supabase Authentication > Providers.

# UniSMS secrets belong in the backend only. Use your dashboard's assigned sender ID.
UNISMS_API_KEY=""
UNISMS_SENDER_ID=""
UNISMS_WEBHOOK_SECRET=""
