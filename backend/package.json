{
  "name": "ecoprawn-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env prisma/seed.cjs",
    "db:connect:supabase": "node --env-file=.env scripts/connect-supabase.cjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:google-user": "node scripts/test-google-user.mjs",
    "test:accounts": "node scripts/test-account-isolation.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "^15.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.4.1",
    "typescript": "^5"
  }
}
