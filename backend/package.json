{
  "name": "ecoprawn-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "test:growth": "bun --no-env-file scripts/test-growth.mjs",
    "dev": "bun --bun vite --port 4000",
    "build": "bun --bun vite build",
    "start": "bun --no-env-file scripts/start.mjs",
    "typecheck": "bun --bun tsc --noEmit",
    "postinstall": "bun --bun prisma generate",
    "db:generate": "bun --bun prisma generate",
    "db:push": "bun --bun prisma db push",
    "db:studio": "bun --bun prisma studio",
    "db:seed": "bun --env-file=.env prisma/seed.cjs",
    "db:connect:supabase": "bun --env-file=.env scripts/connect-supabase.cjs",
    "test:auth": "bun --no-env-file scripts/test-auth.mjs",
    "test:phone-auth": "bun --no-env-file scripts/test-phone-auth.mjs",
    "test:google-user": "bun --no-env-file scripts/test-google-user.mjs",
    "test:accounts": "bun --no-env-file scripts/test-account-isolation.mjs",
    "test:sms": "bun --no-env-file scripts/test-sms.mjs",
    "test:performance": "bun --no-env-file scripts/test-performance.mjs",
    "test:oxygen": "bun --no-env-file scripts/test-oxygen.mjs",
    "test:hardware": "bun --no-env-file scripts/test-hardware.mjs",
    "test:validation": "bun --no-env-file scripts/test-api-validation.mjs",
    "test:oxygen:live": "bun --env-file=.env scripts/test-oxygen.mjs --live"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "react": "^19",
    "react-dom": "^19",
    "tslib": "^2.9.1",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-router": "1.170.46"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.4.1",
    "typescript": "^5",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.261029-rc"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  }
}
